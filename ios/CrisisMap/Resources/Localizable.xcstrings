{
  "sourceLanguage" : "en",
  "strings" : {
    "·" : {
      "comment" : "A non-breaking hyphen used to separate items in a list.",
      "isCommentAutoGenerated" : true
    },
    "%@" : {
      "comment" : "A text label showing the number of events in a given category. The argument is the name of the category.",
      "isCommentAutoGenerated" : true
    },
    "%@ · %@" : {
      "comment" : "Displays the name of a think tank and the publication date of a related research article.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ unplaced events" : {
      "comment" : "A sublabel within the region marker sheet showing the number of unplaced news events.",
      "isCommentAutoGenerated" : true
    },
    "%@%%" : {
      "comment" : "A text label showing the probability of a given market outcome. The value is displayed as a percentage.",
